# GPT-5.4 is selected explicitly in intent2cad/src/llm.py.
OPENAI_API_KEY=
# Optional; leave empty to use the official OpenAI endpoint.
OPENAI_BASE_URL=

# CAD construction records from DeepCAD: <CAD_JSON_ROOT>/<group>/<id>.json
CAD_JSON_ROOT=
# Sketch constraints collected from Onshape through the Onshape API.
# Recursively contains <id>_*_featurescript_*.yml, or <id>.json.
CONSTRAINT_ROOT=
